{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["CLERK_SECRET_KEY"],
      "passThroughEnv": [
        "PORT",
        "MONGODB_URI",
        "CLERK_PUBLISHABLE_KEY",
        "PERSONA_BASE_URL",
        "PERSONA_CREDENTIAL",
        "RCP_PUBLIC_URL",
        "RCP_SECRET"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "generate:openapi": {
      "cache": false,
      "outputs": ["openapi.json"]
    },
    "generate:sdk": {
      "dependsOn": ["api#generate:openapi"],
      "outputs": ["src/generated/**"]
    }
  }
}
